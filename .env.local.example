# ----------------------------------------------------------------------------
# Master Perfume environment variables
# Copy this file to `.env.local` and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser (required by
# the Firebase client SDK). Non-prefixed variables stay server-side only.
# ----------------------------------------------------------------------------

# --- Firebase (from Firebase Console > Project settings > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abcdef

# --- WhatsApp contact number (international format, digits only, no +) ---
# Example for Tanzania: 255712345678
NEXT_PUBLIC_WHATSAPP_NUMBER=255712345678

# --- Instagram handle (without @) ---
NEXT_PUBLIC_INSTAGRAM_HANDLE=masterperfumetz

# --- Admin dashboard password gate ---
# This is read server-side only and never exposed to the browser.
ADMIN_PASSWORD=change-me-to-a-strong-password
